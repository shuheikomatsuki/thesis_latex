{
  "latex-workshop.latex.recipe.default": "uplatex and dvipdfmx",
  "latex-workshop.latex.recipes": [
    {
      "name": "uplatex and dvipdfmx",
      "tools": ["uplatex", "upbibtex", "uplatex", "uplatex", "dvipdfmx"]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "uplatex",
      "command": "uplatex",
      "args": ["-interaction=nonstopmode", "-file-line-error", "%DOC%"]
    },
    {
      "name": "upbibtex",
      "command": "upbibtex",
      "args": ["%DOCFILE%"],
      "env": {
        "BSTINPUTS": ".:/usr/local/texlive/2026/texmf-dist/pbibtex/bst:"
      }
    },
    {
      "name": "dvipdfmx",
      "command": "dvipdfmx",
      "args": ["-f", "txr3.map", "%DOCFILE%.dvi"]
    }
  ]
}
